# ------------------------------------------------------------
# 5) Final diagnostics and graph-ready output
# ------------------------------------------------------------
undump growth

# Particle table: the graph nodes.
write_dump all custom ${outdir}/particles_final.dump      id type x y z radius mass fx fy fz modify sort id
write_dump all custom packing_seed_99223/particles_final.dump      id type x y z radius mass fx fy fz modify sort id

# Interacting pairs: the graph edges.  Values returned by computes are
# stored as floating point, including atom IDs and types; %.0f is therefore
# required for those four integer-valued compute columns.  cutoff radius
# ensures the ID and
# pair/local computes use the same sphere-contact criterion.
compute pairIDs   all property/local patom1 patom2 ptype1 ptype2 cutoff radius
compute pairState all pair/local dist dx dy dz force fx fy fz p1 p2 p3 p4 cutoff radius

dump contacts all local 1 ${outdir}/contacts_final.dump      index c_pairIDs[1] c_pairIDs[2] c_pairIDs[3] c_pairIDs[4]      c_pairState[1] c_pairState[2] c_pairState[3] c_pairState[4]      c_pairState[5] c_pairState[6] c_pairState[7] c_pairState[8]      c_pairState[9] c_pairState[10] c_pairState[11] c_pairState[12]
dump contacts all local 1 packing_seed_99223/contacts_final.dump      index c_pairIDs[1] c_pairIDs[2] c_pairIDs[3] c_pairIDs[4]      c_pairState[1] c_pairState[2] c_pairState[3] c_pairState[4]      c_pairState[5] c_pairState[6] c_pairState[7] c_pairState[8]      c_pairState[9] c_pairState[10] c_pairState[11] c_pairState[12]
dump_modify contacts format line      "%d %.0f %.0f %.0f %.0f %.12e %.12e %.12e %.12e %.12e %.12e %.12e %.12e %.12e %.12e %.12e %.12e"
dump_modify contacts first yes

# One step initializes and writes the local contact dump.
run 1
