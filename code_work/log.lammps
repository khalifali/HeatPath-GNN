unfix grow1
unfix grow2
unfix grow3

# Final particle masses are now restored, so stronger damping is stable and
# accelerates the final mechanical relaxation.
unfix damping
fix dampingFinal all viscous 0.10

# Remove any accumulated center-of-mass drift and relax at final size.
velocity all zero linear
velocity all zero angular
reset_timestep 0

variable nRelax          index 200000
run ${nRelax}
run 200000
