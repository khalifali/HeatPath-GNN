variable finalAtoms    equal atoms
variable finalN1       equal count(bin1)
variable finalN2       equal count(bin2)
variable finalN3       equal count(bin3)
variable finalSolidVol equal c_solidVolume
variable finalPacking  equal v_packingNow
variable finalPorosity equal v_porosityNow
variable finalPressure equal press
variable finalKE       equal ke

